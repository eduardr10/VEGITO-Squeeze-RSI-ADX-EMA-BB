//@version=6
indicator("Vegito", overlay=false, precision=2)

// ==========================================
// --- CONFIGURACIÓN DE ESTILOS Y COLORES ---
// ==========================================
gp_style_bb  = "🎨 Estilo: Bandas Bollinger"
show_bb      = input.bool(true, "Mostrar BB (Precio)", group=gp_style_bb)
col_bb       = input.color(color.new(#2196f3, 40), "Color Bandas", group=gp_style_bb)
width_bb     = input.int(2, "Grosor Línea BB", minval=1, group=gp_style_bb)

gp_style_ema = "🎨 Estilo: EMA 50"
show_ema     = input.bool(true, "Mostrar EMA (Precio)", group=gp_style_ema)
col_ema      = input.color(color.gray, "Color EMA", group=gp_style_ema)
width_ema    = input.int(2, "Grosor EMA", minval=1, group=gp_style_ema)

gp_style_rsi = "🎨 Estilo: RSI"
show_rsi     = input.bool(true, "Mostrar RSI", group=gp_style_rsi)
col_rsi      = input.color(color.black, "Color Línea RSI", group=gp_style_rsi)
col_rsi_up   = input.color(color.red, "Color Sobrecompra (70)", group=gp_style_rsi)
col_rsi_dw   = input.color(color.green, "Color Sobreventa (30)", group=gp_style_rsi)
rsi_style_in = input.string("Dotted", "Estilo Líneas RSI", options=["Solid", "Dotted", "Dashed"], group=gp_style_rsi)

gp_style_adx = "🎨 Estilo: ADX"
show_adx     = input.bool(true, "Mostrar ADX", group=gp_style_adx)
col_adx      = input.color(color.purple, "Color ADX", group=gp_style_adx)
width_adx    = input.int(2, "Grosor ADX", group=gp_style_adx)

gp_style_sqz = "🎨 Estilo: Squeeze"
show_sqz_h   = input.bool(true, "Mostrar Histograma", group=gp_style_sqz)
show_sqz_dot = input.bool(false, "Mostrar Puntos Squeeze (Nivel 50)", group=gp_style_sqz) 

gp_tooltip   = "📊 Compacto de Datos (Tooltip)"
show_tooltip = input.bool(true, "Activar Etiqueta de Resumen", group=gp_tooltip)
col_tool     = input.color(color.new(#ff9800, 20), "Color de la Marca", group=gp_tooltip)

// --- Traducción de Estilos ---
chosen_rsi_style = switch rsi_style_in
    "Solid"  => hline.style_solid
    "Dotted" => hline.style_dotted
    "Dashed" => hline.style_dashed
    => hline.style_dotted

// ==========================================
// --- PARÁMETROS TÉCNICOS ---
// ==========================================
gp_ind   = "⚙️ Parámetros Técnicos"
sens_mode = input.string("Estándar", "Modo de Sensibilidad", options=["Estándar", "Sensible"], group=gp_ind)

ema_len  = input.int(50, "Periodo EMA", 1, 500, group=gp_ind)
sqz_len  = input.int(20, "Periodo Squeeze", 10, 50, group=gp_ind)
bb_len   = input.int(20, "Periodo BB", 1, 200, group=gp_ind)
bb_mult  = input.float(2.0, "Multiplicador BB", 0.1, 5.0, step=0.1, group=gp_ind)

rsi_len = sens_mode == "Sensible" ? 7 : 14
ad_threshold = sens_mode == "Sensible" ? 14 : 20

// ==========================================
// --- CÁLCULOS TÉCNICOS ---
// ==========================================
ema_v = ta.ema(close, ema_len)
[bb_basis, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)
kc_basis = ta.sma(close, sqz_len)
kc_range = ta.sma(ta.tr, sqz_len)
is_sqz_on = (bb_upper < kc_basis + kc_range * 1.5) and (bb_lower > kc_basis - kc_range * 1.5)

rsi_v = ta.rsi(close, rsi_len)
[_, _, adx_v] = ta.dmi(14, 14)

sqz_highest = ta.highest(high, sqz_len)
sqz_lowest  = ta.lowest(low, sqz_len)
sqz_val = ta.linreg(close - math.avg(math.avg(sqz_highest, sqz_lowest), ta.sma(close, sqz_len)), sqz_len, 0)
sq_up = ta.rising(sqz_val, 1)
sq_dn = ta.falling(sqz_val, 1)

// --- Lógica Predictiva (REFERENCIA 50 VELAS) ---
lookback_50 = 50
bull_count = math.sum(close > ema_v ? 1 : 0, lookback_50)
trend_dominance = (bull_count / lookback_50) * 100

// NUEVO: Rango basado en el Máximo y Mínimo real de las últimas 50 velas
range_max_50 = ta.highest(high, lookback_50)
range_min_50 = ta.lowest(low, lookback_50)

// ==========================================
// --- LÓGICA DEL TOOLTIP COMPACTO ---
// ==========================================
if show_tooltip and barstate.islast
    var label compacto = label.new(bar_index, high, text="👁️", color=col_tool, textcolor=color.white, style=label.style_label_down, size=size.small, force_overlay=true)
    
    txt = "📋 VEGITO (" + sens_mode + ")\n"
    txt += "-------------------------\n"
    txt += "RSI: " + str.tostring(rsi_v, "#.##") + " | ADX: " + str.tostring(adx_v, "#.##") + (adx_v > ad_threshold ? " ✅" : " ❌") + "\n"
    txt += "Squeeze: " + (is_sqz_on ? "Compresión 🔒" : "Liberado 🚀") + "\n"
    txt += "Momentum: " + (sqz_val > 0 ? (sq_up ? "Ascenso ▲" : "Agotamiento △") : (sq_dn ? "Descenso ▼" : "Frenado ▽")) + "\n"
    txt += "-------------------------\n"
    txt += "ANÁLISIS ÚLTIMAS 50 VELAS:\n"
    txt += "Dominancia Alcista: " + str.tostring(trend_dominance, "#") + "%\n"
    txt += "Rango Máximo: " + str.tostring(range_max_50, "#.##") + "\n"
    txt += "Rango Mínimo: " + str.tostring(range_min_50, "#.##") + "\n"
    txt += "-------------------------\n"
    txt += "Posición en Rango: " + str.tostring(((close - range_min_50) / (range_max_50 - range_min_50)) * 100, "#") + "% del canal"
    
    label.set_xy(compacto, bar_index, high)
    label.set_tooltip(compacto, txt)

// ==========================================
// --- VISUALIZACIÓN PANEL INFERIOR ---
// ==========================================
sq_max = ta.highest(math.abs(sqz_val), 100)
sq_norm = (sq_max == 0 ? 0 : (sqz_val / sq_max) * 25) + 50
sq_col = sqz_val > 0 ? (sq_up ? #00ff00 : #006400) : (sq_dn ? #ff0000 : #8b0000)

plot(show_sqz_h ? sq_norm : na, "Squeeze Momentum", color=color.new(sq_col, 40), style=plot.style_area, histbase=50)
plot(show_rsi ? rsi_v : na, "RSI", color=col_rsi, linewidth=1)
plot(show_adx ? adx_v : na, "ADX Fuerza", color=col_adx, linewidth=width_adx)
plot(show_sqz_dot ? 50 : na, "Puntos Squeeze", color=is_sqz_on ? color.red : color.green, style=plot.style_circles, linewidth=2)

hline(70, "Sobrecompra", color=col_rsi_up, linestyle=chosen_rsi_style)
hline(30, "Sobreventa", color=col_rsi_dw, linestyle=chosen_rsi_style)
hline(ad_threshold, "Umbral ADX", color=color.new(col_adx, 60), linestyle=hline.style_solid)
hline(50, "Neutral", color=color.new(color.white, 80))

// --- OVERLAY ---
plot(show_bb ? bb_upper : na, "BB Superior", color=col_bb, linewidth=width_bb, force_overlay=true)
plot(show_bb ? bb_lower : na, "BB Inferior", color=col_bb, linewidth=width_bb, force_overlay=true)
plot(show_ema ? ema_v : na, "EMA 50", color=col_ema, linewidth=width_ema, force_overlay=true)
