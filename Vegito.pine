//@version=6
indicator("VEGITO", overlay=false, precision=2)

// ==========================================
// --- CONFIGURACIÓN VISUAL ---
// ==========================================
gp_style_bb  = "🎨 Estilo: Bandas Bollinger"
show_bb      = input.bool(true, "Mostrar BB (Precio)", group=gp_style_bb)
col_bb       = input.color(color.new(#606060, 40), "Color Bandas", group=gp_style_bb)

gp_style_ema = "🎨 Estilo: EMA 50"
show_ema     = input.bool(true, "Mostrar EMA (Precio)", group=gp_style_ema)
col_ema      = input.color(#FFD700, "Color EMA", group=gp_style_ema) 

gp_panel     = "🖥️ Panel de Confluencia (MTF)"
show_panel   = input.bool(true, "Mostrar Panel en Precio", group=gp_panel)
pos_panel    = input.string("Top Right", "Posición", options=["Top Right", "Bottom Right", "Top Left"], group=gp_panel)

gp_tooltip   = "📊 Configuración Tooltip"
tooltip_freq = input.int(50, "Frecuencia de Ojos Históricos", minval=10)

// ==========================================
// --- MOTOR TÉCNICO LOCAL ---
// ==========================================
ema_v = ta.ema(close, 50)
[bb_basis, bb_upper, bb_lower] = ta.bb(close, 20, 2.0)
rsi_v = ta.rsi(close, 14)
[_, _, adx_v] = ta.dmi(14, 14)

// Squeeze Local (Cálculo directo sin =>)
h20 = ta.highest(high, 20)
l20 = ta.lowest(low, 20)
a20 = ta.sma(close, 20)
sqz_now = ta.linreg(close - math.avg(math.avg(h20, l20), a20), 20, 0)
sq_up = ta.rising(sqz_now, 1)
dist_val = ((close - ema_v) / ema_v) * 100

// ==========================================
// --- DATOS MULTITEMPORALES (MTF) ---
// ==========================================
// 1 HORA
rsi_1h  = request.security(syminfo.tickerid, "60", ta.rsi(close, 14))
adx_1h  = request.security(syminfo.tickerid, "60", adx_v)
dist_1h = request.security(syminfo.tickerid, "60", ((close - ta.ema(close, 50)) / ta.ema(close, 50)) * 100)
sqz_1h  = request.security(syminfo.tickerid, "60", ta.linreg(close - math.avg(math.avg(ta.highest(high, 20), ta.lowest(low, 20)), ta.sma(close, 20)), 20, 0))

// 4 HORAS
rsi_4h  = request.security(syminfo.tickerid, "240", ta.rsi(close, 14))
adx_4h  = request.security(syminfo.tickerid, "240", adx_v)
dist_4h = request.security(syminfo.tickerid, "240", ((close - ta.ema(close, 50)) / ta.ema(close, 50)) * 100)
sqz_4h  = request.security(syminfo.tickerid, "240", ta.linreg(close - math.avg(math.avg(ta.highest(high, 20), ta.lowest(low, 20)), ta.sma(close, 20)), 20, 0))

// DIARIO
rsi_1d  = request.security(syminfo.tickerid, "D", ta.rsi(close, 14))
adx_1d  = request.security(syminfo.tickerid, "D", adx_v)
dist_1d = request.security(syminfo.tickerid, "D", ((close - ta.ema(close, 50)) / ta.ema(close, 50)) * 100)
sqz_1d  = request.security(syminfo.tickerid, "D", ta.linreg(close - math.avg(math.avg(ta.highest(high, 20), ta.lowest(low, 20)), ta.sma(close, 20)), 20, 0))

// ==========================================
// --- CONTROL DE ETIQUETAS (OJOS) ---
// ==========================================
var label last_label = na
if barstate.islast
    label.delete(last_label)

is_step_bar = bar_index % tooltip_freq == 0
if is_step_bar or barstate.islast
    txt = "📊 DIAGNÓSTICO VEGITO\n-------------------------\n"
    txt += "ESTRUCTURA: " + (close > ema_v ? "ALCISTA" : "BAJISTA") + "\n"
    txt += "FUERZA ADX: " + (adx_v > 25 ? "FUERTE" : "DÉBIL") + "\n"
    txt += "SQUEEZE: " + (sqz_now > 0 ? "Momentum 🟢" : "Momentum 🔴") + "\n-------------------------\n"
    txt += "SITUACIÓN 1D:\nRSI: " + str.tostring(rsi_1d, "#") + " | Dist: " + str.tostring(dist_1d, "#.##") + "%"
    
    lbl = label.new(bar_index, high, "👁️", yloc=yloc.abovebar, color=color.new(#ff9800, 20), style=label.style_label_down, size=size.small, force_overlay=true, tooltip=txt)
    if barstate.islast
        last_label := lbl

// ==========================================
// --- TABLA MTF INTEGRAL ---
// ==========================================
if show_panel and barstate.islast
    var table mtf_table = table.new(pos_panel == "Top Right" ? position.top_right : pos_panel == "Bottom Right" ? position.bottom_right : position.top_left, 5, 4, border_width=1, frame_color=color.gray, border_color=color.gray, force_overlay=true)
    h_col = color.new(color.gray, 20)
    
    // Encabezados
    table.cell(mtf_table, 0, 0, "TF", bgcolor=h_col, text_color=color.white)
    table.cell(mtf_table, 1, 0, "RSI", bgcolor=h_col, text_color=color.white)
    table.cell(mtf_table, 2, 0, "ADX", bgcolor=h_col, text_color=color.white)
    table.cell(mtf_table, 3, 0, "Dist. EMA", bgcolor=h_col, text_color=color.white)
    table.cell(mtf_table, 4, 0, "SQUEEZE", bgcolor=h_col, text_color=color.white)
    
    // Fila 1H
    table.cell(mtf_table, 0, 1, "1H", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 1, 1, str.tostring(rsi_1h, "#"), bgcolor=rsi_1h > 70 ? color.new(color.red, 40) : rsi_1h < 30 ? color.new(color.green, 40) : color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 2, 1, str.tostring(adx_1h, "#"), bgcolor=adx_1h > 25 ? color.new(color.purple, 40) : color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 3, 1, (dist_1h > 0 ? "+" : "") + str.tostring(dist_1h, "#.##") + "%", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 4, 1, sqz_1h > 0 ? "🟢" : "🔴", bgcolor=color.new(color.black, 70), text_color=color.white)

    // Fila 4H
    table.cell(mtf_table, 0, 2, "4H", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 1, 2, str.tostring(rsi_4h, "#"), bgcolor=rsi_4h > 70 ? color.new(color.red, 40) : rsi_4h < 30 ? color.new(color.green, 40) : color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 2, 2, str.tostring(adx_4h, "#"), bgcolor=adx_4h > 25 ? color.new(color.purple, 40) : color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 3, 2, (dist_4h > 0 ? "+" : "") + str.tostring(dist_4h, "#.##") + "%", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 4, 2, sqz_4h > 0 ? "🟢" : "🔴", bgcolor=color.new(color.black, 70), text_color=color.white)

    // Fila 1D
    table.cell(mtf_table, 0, 3, "1D", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 1, 3, str.tostring(rsi_1d, "#"), bgcolor=rsi_1d > 70 ? color.new(color.red, 40) : rsi_1d < 30 ? color.new(color.green, 40) : color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 2, 3, str.tostring(adx_1d, "#"), bgcolor=adx_1d > 25 ? color.new(color.purple, 40) : color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 3, 3, (dist_1d > 0 ? "+" : "") + str.tostring(dist_1d, "#.##") + "%", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(mtf_table, 4, 3, sqz_1d > 0 ? "🟢" : "🔴", bgcolor=color.new(color.black, 70), text_color=color.white)

// ==========================================
// --- PANEL INFERIOR ---
// ==========================================
sq_max = ta.highest(math.abs(sqz_now), 100)
sq_norm = (sq_max == 0 ? 0 : (sqz_now / sq_max) * 25) + 50
sq_col = sqz_now > 0 ? (sq_up ? #00ff00 : #006400) : (ta.falling(sqz_now, 1) ? #ff0000 : #8b0000)

plot(sq_norm, "Squeeze", color=color.new(sq_col, 40), style=plot.style_area, histbase=50)
plot(rsi_v, "RSI", color=color.black)
plot(adx_v, "ADX", color=color.purple, linewidth=2)
hline(70, "OB", color=color.new(color.red, 50), linestyle=hline.style_dotted)
hline(30, "OS", color=color.new(color.green, 50), linestyle=hline.style_dotted)

// DIBUJOS EN PRECIO
plot(show_bb ? bb_upper : na, "BB Upper", color=col_bb, force_overlay=true)
plot(show_bb ? bb_lower : na, "BB Lower", color=col_bb, force_overlay=true)
plot(show_ema ? ema_v : na, "EMA 50", color=col_ema, linewidth=2, force_overlay=true)
