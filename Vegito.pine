//@version=6
indicator("Vegito", overlay=false, precision=2)

// ==========================================
// --- CONFIGURACIÓN VISUAL ---
// ==========================================
gp_style_bb  = "🎨 Estilo: Bandas Bollinger"
show_bb      = input.bool(true, "Mostrar BB (Precio)", group=gp_style_bb)
col_bb       = input.color(color.new(#2196f3, 40), "Color Bandas", group=gp_style_bb)

gp_style_ema = "🎨 Estilo: EMA 50"
show_ema     = input.bool(true, "Mostrar EMA (Precio)", group=gp_style_ema)
col_ema      = input.color(color.gray, "Color EMA", group=gp_style_ema)

gp_style_sqz = "🎨 Estilo: Squeeze"
show_sqz_h   = input.bool(true, "Mostrar Histograma Squeeze", group=gp_style_sqz)
show_sqz_dot = input.bool(true, "Mostrar Puntos Squeeze", group=gp_style_sqz)

gp_style_rsi = "🎨 Estilo: RSI"
show_rsi     = input.bool(true, "Mostrar RSI", group=gp_style_rsi)
col_rsi      = input.color(color.black, "Color Línea RSI", group=gp_style_rsi)

gp_style_adx = "🎨 Estilo: ADX"
show_adx     = input.bool(true, "Mostrar ADX", group=gp_style_adx)
col_adx      = input.color(color.purple, "Color ADX", group=gp_style_adx)

gp_tooltip   = "📊 Análisis de Datos (Tooltip)"
show_tooltip = input.bool(true, "Activar Tooltip de Análisis", group=gp_tooltip)
tooltip_freq = input.int(50, "Frecuencia de Análisis (Velas)", minval=10, group=gp_tooltip)
col_tool     = input.color(color.new(#ff9800, 20), "Color Icono Análisis", group=gp_tooltip)

// ==========================================
// --- MOTOR TÉCNICO ---
// ==========================================
ema_v = ta.ema(close, 50)
[bb_basis, bb_upper, bb_lower] = ta.bb(close, 20, 2.0)

// Squeeze Momentum
sqz_val = ta.linreg(close - math.avg(math.avg(ta.highest(high, 20), ta.lowest(low, 20)), ta.sma(close, 20)), 20, 0)
sq_up = ta.rising(sqz_val, 1), sq_dn = ta.falling(sqz_val, 1)
is_sqz_on = (bb_upper < ta.sma(close, 20) + ta.sma(ta.tr, 20) * 1.5) and (bb_lower > ta.sma(close, 20) - ta.sma(ta.tr, 20) * 1.5)

rsi_v = ta.rsi(close, 14)
[_, _, adx_v] = ta.dmi(14, 14)
vol_avg = ta.sma(volume, 20)

// ==========================================
// --- LÓGICA DE TOOLTIP ÚNICO ---
// ==========================================
var label last_label = na
is_step_bar = bar_index % tooltip_freq == 0
should_show = show_tooltip and (is_step_bar or barstate.islast)

if should_show
    if barstate.islast and not is_step_bar
        label.delete(last_label)

    lbl = label.new(bar_index, high, "👁️", color=col_tool, textcolor=color.black, style=label.style_label_down, size=size.small, force_overlay=true)
    
    txt = "🧠 ANÁLISIS VEGITO\n"
    txt += "-------------------------\n"
    txt += "RSI: " + str.tostring(rsi_v, "#.#") + "\n"
    txt += "ADX: " + str.tostring(adx_v, "#.#") + "\n"
    txt += "Squeeze: " + (sqz_val > 0 ? "BULL" : "BEAR") + (sq_up ? " ↗️" : " ↘️") + "\n"
    txt += "Volumen: " + (volume > vol_avg ? "ALTO ✅" : "Normal") + "\n"
    txt += "-------------------------\n"
    txt += "EMA 50: " + (close > ema_v ? "Por encima" : "Por debajo") + "\n"
    txt += "BB: " + (close > bb_upper ? "Exceso Alcista" : close < bb_lower ? "Exceso Bajista" : "Dentro de Rango")
    
    label.set_tooltip(lbl, txt)
    if barstate.islast
        last_label := lbl

// ==========================================
// --- VISUALIZACIÓN PANEL INFERIOR ---
// ==========================================
sq_max = ta.highest(math.abs(sqz_val), 100)
sq_norm = (sq_max == 0 ? 0 : (sqz_val / sq_max) * 25) + 50
sq_col = sqz_val > 0 ? (sq_up ? #00ff00 : #006400) : (sq_dn ? #ff0000 : #8b0000)

plot(show_sqz_h ? sq_norm : na, "Squeeze", color=color.new(sq_col, 40), style=plot.style_area, histbase=50)
plot(show_rsi ? rsi_v : na, "RSI", color=col_rsi)
plot(show_adx ? adx_v : na, "ADX", color=col_adx, linewidth=2)
plot(show_sqz_dot ? 50 : na, "SQZ Dot", color=is_sqz_on ? color.red : color.green, style=plot.style_circles, linewidth=2)

hline(70, "OB", color=color.new(color.red, 50), linestyle=hline.style_dotted)
hline(30, "OS", color=color.new(color.green, 50), linestyle=hline.style_dotted)

// Overlay Precio
plot(show_bb ? bb_upper : na, "BB Upper", color=col_bb, force_overlay=true)
plot(show_bb ? bb_lower : na, "BB Lower", color=col_bb, force_overlay=true)
plot(show_ema ? ema_v : na, "EMA 50", color=col_ema, force_overlay=true)
